# ==========================================
# DOCSHIELD AI — SYSTEM ENVIRONMENT CONFIG
# ==========================================

# Backend API Configuration
PROJECT_NAME="DocShield AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite local default or PostgreSQL/Supabase)
DATABASE_URL=sqlite:///./docshield.db
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & Storage (Optional Cloud Sync)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your-anon-public-key-here

# Local Storage Paths
UPLOAD_DIR=./storage/uploads
REPORT_DIR=./storage/reports
HEATMAP_DIR=./storage/heatmaps

# Data Retention & Privacy (Hours before file purge)
DOCUMENT_RETENTION_HOURS=24

# Frontend Environment Variables (.env.local in /frontend)
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
# NEXT_PUBLIC_APP_NAME="DocShield AI"
# NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
